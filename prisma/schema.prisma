// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Commands to know:
// `npx prisma generate` - update TypeScript definitions based on this schema
// `npx prisma db push` - push the schema changes to the database
// `npx prisma studio` - open the Studio, which allows you to edit the schema.
// `npx prisma migrate reset` - reset the migrations to the last version. This will reset the DB and run the seed script
// `npx prisma migrate dev --name <descriptive-name>` - generate a migration file for any changes you make to the schema (this will be committed).

generator client {
  provider = "prisma-client"
  output   = "../app/lib/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  userAuthId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Invoice Invoice[]

  @@map("users")
}

model Invoice {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug       String   @unique
  paymentDue DateTime

  paymentTerms Int
  status       String? @default("pending")
  total        Float

  clientName    String
  clientEmail   String
  clientAddress Address
  senderAddress Address

  issued      DateTime
  description String
  items       InvoiceItem[]

  user   User?   @relation(fields: [userId], references: [userAuthId], onDelete: Cascade)
  userId String?

  @@map("invoices")
}

type InvoiceItem {
  id       String
  name     String
  quantity Int
  price    Float
  total    Float
}

type Address {
  street   String
  city     String
  postCode String
  country  String
}
